@model AutoTracker.ViewModels.ReportsViewModel

@{
    ViewData["Title"] = "Reports";
}

<div class="page-header">
    <h1>Reports</h1>
    <p>Workshop performance, turnover and job status overview.</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <span>Total Jobs</span>
        <strong>@Model.TotalJobs</strong>
    </div>

    <div class="stat-card">
        <span>Active Jobs</span>
        <strong>@Model.ActiveJobs</strong>
    </div>

    <div class="stat-card success">
        <span>Completed Jobs</span>
        <strong>@Model.CompletedJobs</strong>
    </div>

    <div class="stat-card danger">
        <span>Overdue Jobs</span>
        <strong>@Model.OverdueJobs</strong>
    </div>

    <div class="stat-card success">
        <span>Monthly Turnover</span>
        <strong>R @Model.MonthlyTurnover.ToString("N2")</strong>
    </div>

    <div class="stat-card warning">
        <span>Monthly Costs</span>
        <strong>R @Model.MonthlyCosts.ToString("N2")</strong>
    </div>

    <div class="stat-card success">
        <span>Monthly Profit</span>
        <strong>R @Model.MonthlyProfit.ToString("N2")</strong>
    </div>

    <div class="stat-card warning">
        <span>Avg Repair Days</span>
        <strong>@Model.AverageRepairDays.ToString("N1")</strong>
    </div>
</div>

<div class="dashboard-card mt-3">
    <h3>Jobs By Status</h3>

    @if (Model.JobsByStatus.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Status</th>
                    <th>Count</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.JobsByStatus)
                {
                    <tr>
                        <td>@item.Status</td>
                        <td>@item.Count</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No job data yet.</p>
    }
</div>