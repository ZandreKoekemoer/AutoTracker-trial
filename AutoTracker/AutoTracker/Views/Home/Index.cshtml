@model AutoTracker.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-header">
    <div>
        <h1>Workshop Dashboard</h1>
        <p>Live overview of active repairs, missing documents and workshop progress.</p>
    </div>

    <a asp-controller="RepairJobs" asp-action="Create" class="btn btn-primary">+ New Repair Job</a>
</div>

<div class="stats-grid">
    <a class="stat-card" asp-controller="RepairJobs" asp-action="Index">
        <span>Active Jobs</span>
        <strong>@Model.TotalActiveJobs</strong>
    </a>

    <a class="stat-card warning" asp-controller="RepairJobs" asp-action="Index" asp-route-search="Waiting Approval">
        <span>Waiting Approval</span>
        <strong>@Model.WaitingApproval</strong>
    </a>

    <a class="stat-card success" asp-controller="RepairJobs" asp-action="Index" asp-route-search="Ready">
        <span>Ready</span>
        <strong>@Model.ReadyForCollection</strong>
    </a>

    <a class="stat-card danger" asp-controller="Calendar" asp-action="Index">
        <span>Overdue</span>
        <strong>@Model.OverdueJobs</strong>
    </a>

    <a class="stat-card danger" asp-controller="RepairJobs" asp-action="Index">
        <span>Missing Docs</span>
        <strong>@Model.MissingDocuments</strong>
    </a>

    <a class="stat-card" asp-controller="Reports" asp-action="Index">
        <span>Collected This Month</span>
        <strong>@Model.CollectedThisMonth</strong>
    </a>

    @if (ViewBag.CanSeeFinancials)
    {
        <a class="stat-card success" asp-controller="Reports" asp-action="Index">
            <span>Monthly Profit</span>
            <strong>R @Model.MonthlyProfit.ToString("N2")</strong>
        </a>
    }
</div>

<div class="dashboard-grid">
    <div class="dashboard-card">
        <h3>Recent Repair Jobs</h3>

        @if (Model.RecentJobs.Any())
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>REG</th>
                        <th>Client</th>
                        <th>Status</th>
                        <th>Assigned User</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.RecentJobs)
                    {
                        <tr>
                            <td>@job.Vehicle?.RegNumber</td>
                            <td>@job.Client?.FullName</td>
                            <td><span class="status-pill">@job.Status</span></td>
                            <td>@job.AssignedTechnician</td>
                            <td>
                                <a asp-controller="RepairJobs" asp-action="Details" asp-route-id="@job.Id">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p>No active repair jobs yet.</p>
        }
    </div>

    <div class="dashboard-card">
        <h3>Missing Requirements</h3>

        @if (Model.JobsWithMissingRequirements.Any())
        {
            <ul class="clean-list">
                @foreach (var job in Model.JobsWithMissingRequirements)
                {
                    <li>
                        <strong>@job.Vehicle?.RegNumber</strong>
                        <span>@job.Client?.FullName</span>
                        <a asp-controller="RepairJobs" asp-action="Details" asp-route-id="@job.Id">Fix</a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>Everything looks clean.</p>
        }
    </div>
</div>

<div class="dashboard-card mt-3">
    <h3>Recent Activity</h3>

    @if (Model.RecentActivity.Any())
    {
        <ul class="activity-list">
            @foreach (var log in Model.RecentActivity)
            {
                <li>
                    <strong>@log.CreatedAt.ToString("dd MMM HH:mm")</strong>
                    <span>@log.Action</span>
                </li>
            }
        </ul>
    }
    else
    {
        <p>No activity yet.</p>
    }
</div>