@model AutoTracker.ViewModels.NotificationViewModel

@{
    ViewData["Title"] = "Notifications";
}

<div class="page-header">
    <h1>Workshop Alerts</h1>
    <p>Items that need attention before repairs can continue or close.</p>
</div>

@if (Model.Items.Any())
{
    <div class="dashboard-card">
        @foreach (var item in Model.Items)
        {
            var cssClass = item.Severity switch
            {
                "Danger" => "alert-danger",
                "Warning" => "alert-warning",
                _ => "alert-info"
            };

            <div class="alert @cssClass d-flex justify-content-between align-items-center">
                <div>
                    <strong>@item.Type</strong><br />
                    @item.Message
                </div>

                @if (item.RepairJobId.HasValue)
                {
                    <a asp-controller="RepairJobs" asp-action="Details" asp-route-id="@item.RepairJobId" class="btn btn-sm btn-dark">
                        Open
                    </a>
                }
            </div>
        }
    </div>
}
else
{
    <div class="dashboard-card">
        <h3>All clear ✅</h3>
        <p>No active alerts right now.</p>
    </div>
}