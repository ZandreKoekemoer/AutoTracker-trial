@using System.Text.Encodings.Web
@model AutoTracker.Models.RepairJob
@{
    ViewData["Title"] = "Estimate";
    var quote = Model.Quote;
    var settings = ViewBag.CompanySettings as AutoTracker.Models.CompanySetting ?? new AutoTracker.Models.CompanySetting();
    var items = quote?.LineItems?.OrderBy(x => x.SortOrder).ToList() ?? new List<AutoTracker.Models.QuoteLineItem>();
    var parts = items.Where(x => x.Section == "Parts").ToList();
    var labour = items.Where(x => x.Section == "Labour").ToList();
    var paint = items.Where(x => x.Section == "Paint").ToList();
    var strip = items.Where(x => x.Section == "StripAndAssemble").ToList();
}

<div class="page-title">
    <h1>Estimate - @Model.Vehicle?.RegNumber</h1>
    <p>Paper-style estimate builder with parts, labour, paint and strip & assemble.</p>
</div>

@if (TempData["Success"] != null) { <div class="alert success">@TempData["Success"]</div> }

<div class="action-row">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn secondary">Back to Job</a>
    <a asp-action="QuotePdf" asp-route-id="@Model.Id" target="_blank" class="btn">Print / Save PDF</a>
    @if (quote != null && string.IsNullOrWhiteSpace(quote.InvoiceNumber))
    {
        <form asp-action="GenerateInvoiceNumber" method="post" style="display:inline">
            <input type="hidden" name="repairJobId" value="@Model.Id" />
            <button class="btn secondary">Generate Invoice No.</button>
        </form>
    }
</div>
@*
Reference: Quotation generator – HTML quotation layout
According to Callmephil (2025), quotations can contain customer details, item lines, prices, totals, terms and signatures.
I used this reference to structure the custom repair quote.
*@
@if (quote != null)
{
<form asp-action="UpdateQuote" method="post" class="card quote-builder">
    <input type="hidden" name="repairJobId" value="@Model.Id" />

    <div class="estimate-top">
        <div>
            @if (!string.IsNullOrWhiteSpace(settings.LogoPath)) { <img src="@settings.LogoPath" class="estimate-logo" /> }
            <h2>@settings.CompanyName</h2>
            <p>@settings.Address</p>
            <p>@settings.Phone | @settings.Email</p>
            <p>VAT Reg No: @settings.VatNumber</p>
        </div>
        <div class="estimate-title">
            <h2>Estimate Preview</h2>
            <p><strong>No:</strong> @quote.QuoteNumber</p>
            <p><strong>Date:</strong> @quote.QuoteDate.ToString("dd/MM/yyyy")</p>
            @if (!string.IsNullOrWhiteSpace(quote.InvoiceNumber)) { <p><strong>Invoice:</strong> @quote.InvoiceNumber</p> }
        </div>
    </div>

    <div class="estimate-info-grid">
        <div><strong>Client</strong><br />@Model.Client?.FullName<br />@Model.Client?.Address<br />@Model.Client?.Phone<br />@Model.Client?.Email</div>
        <div><strong>Vehicle</strong><br />@Model.Vehicle?.VehicleType<br />Registration: @Model.Vehicle?.RegNumber<br />Chassis No: @Model.Vehicle?.VinNumber</div>
        <div><strong>Reference</strong><br />Owner Phone: @Model.Client?.Phone<br />RFID: @Model.RfidTagCode<br />Status: @Model.Status</div>
    </div>

    <h3>Estimate Lines</h3>
    <p class="muted">Leave Value empty to auto-calculate using Company Settings rates. Fill Value to override.</p>

    <div class="quote-section" data-section="Parts">
        <h4>Parts</h4>
        <table class="quote-input-table"><thead><tr><th>Method</th><th>Part / Description</th><th>Qty</th><th>Price</th><th>Value</th><th></th></tr></thead><tbody id="partsRows">
        @foreach (var row in parts) { <tr>@Html.Raw(RowInputs("Parts", row))</tr> }
        </tbody></table>
        <button type="button" class="btn secondary small" onclick="addPartsRow()">+ Add Part</button>
    </div>

    <div class="quote-section">
        <h4>Labour / Repairs</h4>
        <table class="quote-input-table"><thead><tr><th>Code</th><th>Description</th><th>Hours</th><th>Value</th><th></th></tr></thead><tbody id="labourRows">
        @foreach (var row in labour) { <tr>@Html.Raw(RowInputs("Labour", row))</tr> }
        </tbody></table>
        <button type="button" class="btn secondary small" onclick="addLabourRow()">+ Add Labour</button>
    </div>

    <div class="quote-section">
        <h4>Paint / Spray</h4>
        <table class="quote-input-table"><thead><tr><th>Panel / Code</th><th>Description</th><th>Panels</th><th>Value</th><th></th></tr></thead><tbody id="paintRows">
        @foreach (var row in paint) { <tr>@Html.Raw(RowInputs("Paint", row))</tr> }
        </tbody></table>
        <button type="button" class="btn secondary small" onclick="addPaintRow()">+ Add Paint</button>
    </div>

    <div class="quote-section">
        <h4>Strip & Assemble</h4>
        <table class="quote-input-table"><thead><tr><th>Code</th><th>Description</th><th>Hours</th><th>Value</th><th></th></tr></thead><tbody id="stripRows">
        @foreach (var row in strip) { <tr>@Html.Raw(RowInputs("StripAndAssemble", row))</tr> }
        </tbody></table>
        <button type="button" class="btn secondary small" onclick="addStripRow()">+ Add Strip & Assemble</button>
    </div>

    <div class="totals-edit">
        <div><label>Consumables</label><input name="Consumables" value="@quote.Consumables" type="number" step="0.01" /></div>
        <div><label>Sublet</label><input name="Sublet" value="@quote.Sublet" type="number" step="0.01" /></div>
        <div><label>Discount</label><input name="Discount" value="@quote.Discount" type="number" step="0.01" /></div>
    </div>

    <div class="quote-total-box">
        <div>Parts <strong>R @quote.Parts.ToString("N2")</strong></div>
        <div>Labour <strong>R @quote.Labour.ToString("N2")</strong></div>
        <div>Paint <strong>R @quote.Paint.ToString("N2")</strong></div>
        <div>Strip & Assemble <strong>R @quote.StripAndAssemble.ToString("N2")</strong></div>
        <div>Subtotal <strong>R @quote.Subtotal.ToString("N2")</strong></div>
        <div>VAT <strong>R @quote.Vat.ToString("N2")</strong></div>
        <div class="grand">Total <strong>R @quote.Total.ToString("N2")</strong></div>
    </div>

    <label>Notes</label><textarea name="Notes">@quote.Notes</textarea>
    <label>Terms</label><textarea name="Terms">@(string.IsNullOrWhiteSpace(quote.Terms) ? settings.QuoteFooterText : quote.Terms)</textarea>

    <button class="btn">Save Full Estimate</button>
</form>
}

@functions {
    string E(string? value) => HtmlEncoder.Default.Encode(value ?? "");
    string RowInputs(string section, AutoTracker.Models.QuoteLineItem row)
    {
        string remove = "<button type='button' class='btn danger small' onclick='this.closest(\"tr\").remove()'>x</button>";
        if (section == "Parts")
            return $"<td><input name='Section' value='Parts' type='hidden'><input name='Method' value='{E(row.Method)}'></td><td><input name='Description' value='{E(row.Description)}'></td><td><input name='Quantity' type='number' min='1' step='1' value='{row.Quantity}'></td><td><input name='UnitPrice' type='number' step='0.01' value='{row.UnitPrice}'></td><td><input name='Value' type='number' step='0.01' value='{row.Value}'><input name='Code' value='' type='hidden'><input name='Hours' value='0' type='hidden'><input name='Panels' value='0' type='hidden'></td><td>{remove}</td>";
        if (section == "Paint")
            return $"<td><input name='Section' value='Paint' type='hidden'><input name='Code' value='{E(row.Code)}'></td><td><input name='Description' value='{E(row.Description)}'><input name='Method' value='' type='hidden'><input name='Quantity' value='0' type='hidden'><input name='UnitPrice' value='0' type='hidden'><input name='Hours' value='0' type='hidden'></td><td><input name='Panels' type='number' step='0.01' value='{row.Panels}'></td><td><input name='Value' type='number' step='0.01' value='{row.Value}'></td><td>{remove}</td>";
        return $"<td><input name='Section' value='{section}' type='hidden'><input name='Code' value='{E(row.Code)}'></td><td><input name='Description' value='{E(row.Description)}'><input name='Method' value='' type='hidden'><input name='Quantity' value='0' type='hidden'><input name='UnitPrice' value='0' type='hidden'><input name='Panels' value='0' type='hidden'></td><td><input name='Hours' type='number' step='0.01' value='{row.Hours}'></td><td><input name='Value' type='number' step='0.01' value='{row.Value}'></td><td>{remove}</td>";
    }
}

<script>
function removeBtn(){return `<button type="button" class="btn danger small" onclick="this.closest('tr').remove()">x</button>`}
function addPartsRow(){document.getElementById('partsRows').insertAdjacentHTML('beforeend', `<tr><td><input name="Section" value="Parts" type="hidden"><input name="Method" placeholder="Altern/Repair"></td><td><input name="Description" placeholder="Front bumper clips"></td><td><input name="Quantity" type="number" min="1" step="1" value="1"></td><td><input name="UnitPrice" type="number" step="0.01"></td><td><input name="Value" type="number" step="0.01"><input name="Code" value="" type="hidden"><input name="Hours" value="0" type="hidden"><input name="Panels" value="0" type="hidden"></td><td>${removeBtn()}</td></tr>`) }
function addLabourRow(){document.getElementById('labourRows').insertAdjacentHTML('beforeend', `<tr><td><input name="Section" value="Labour" type="hidden"><input name="Code" placeholder="Repair"></td><td><input name="Description" placeholder="Labour / repairs"><input name="Method" value="" type="hidden"><input name="Quantity" value="0" type="hidden"><input name="UnitPrice" value="0" type="hidden"><input name="Panels" value="0" type="hidden"></td><td><input name="Hours" type="number" step="0.01"></td><td><input name="Value" type="number" step="0.01"></td><td>${removeBtn()}</td></tr>`) }
function addPaintRow(){document.getElementById('paintRows').insertAdjacentHTML('beforeend', `<tr><td><input name="Section" value="Paint" type="hidden"><input name="Code" placeholder="Pnls"></td><td><input name="Description" placeholder="Paint/spray panel"><input name="Method" value="" type="hidden"><input name="Quantity" value="0" type="hidden"><input name="UnitPrice" value="0" type="hidden"><input name="Hours" value="0" type="hidden"></td><td><input name="Panels" type="number" step="0.01"></td><td><input name="Value" type="number" step="0.01"></td><td>${removeBtn()}</td></tr>`) }
function addStripRow(){document.getElementById('stripRows').insertAdjacentHTML('beforeend', `<tr><td><input name="Section" value="StripAndAssemble" type="hidden"><input name="Code" placeholder="Strip"></td><td><input name="Description" placeholder="Strip & assemble"><input name="Method" value="" type="hidden"><input name="Quantity" value="0" type="hidden"><input name="UnitPrice" value="0" type="hidden"><input name="Panels" value="0" type="hidden"></td><td><input name="Hours" type="number" step="0.01"></td><td><input name="Value" type="number" step="0.01"></td><td>${removeBtn()}</td></tr>`) }
if(!document.querySelector('#partsRows tr')) addPartsRow();
if(!document.querySelector('#labourRows tr')) addLabourRow();
if(!document.querySelector('#paintRows tr')) addPaintRow();
if(!document.querySelector('#stripRows tr')) addStripRow();
</script>

