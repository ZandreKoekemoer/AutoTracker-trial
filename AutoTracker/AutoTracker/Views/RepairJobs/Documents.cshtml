@model AutoTracker.Models.RepairJob
@using AutoTracker.Models

@{
    ViewData["Title"] = "Documents";
    var documentTypes = DocumentTypes.All.ToList();
}

<h1>Documents - @Model.Vehicle?.RegNumber</h1>
<a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary mb-3">Back to Job</a>

<div class="stats-grid mb-3">
    <div class="stat-card"><span>Quote Total</span><strong>R @(Model.Quote?.Total.ToString("N2") ?? "0.00")</strong></div>
    <div class="stat-card warning"><span>Job Costs</span><strong>R @Model.ActualTotalCost.ToString("N2")</strong></div>
    <div class="stat-card success"><span>Profit</span><strong>R @Model.Profit.ToString("N2")</strong></div>
    <div class="stat-card"><span>Margin</span><strong>@Model.ProfitMargin.ToString("N2")%</strong></div>
</div>

<div class="row g-3">
@foreach (var type in documentTypes)
{
    var docs = Model.Documents.Where(d => DocumentTypes.Normalize(d.DocumentType) == type).OrderByDescending(d => d.UploadedAt).ToList();
    var completed = docs.Any(d => d.IsCompleted);
    var isCost = DocumentTypes.CostDocuments.Contains(type);
    <div class="col-md-6">
        <div class="card p-3 h-100">
            <h4>@type @if (completed) { <span class="badge bg-success">Complete</span> } else { <span class="badge bg-danger">Missing</span> }</h4>
            @if (docs.Any())
            {
                <ul>
                    @foreach (var doc in docs)
                    {
                        <li>
                            <a href="@doc.FilePath" target="_blank">@doc.FileName</a>
                            <small>@doc.UploadedAt.ToString("dd MMM yyyy HH:mm")</small>
                            @if (doc.CostAmount > 0) { <strong> - R @doc.CostAmount.ToString("N2")</strong> }
                        </li>
                    }
                </ul>
            }
            <form asp-action="UploadDocument" method="post" enctype="multipart/form-data">
                <input type="hidden" name="repairJobId" value="@Model.Id" />
                <input type="hidden" name="documentType" value="@type" />
                <input type="file" name="file" class="form-control" />
                @if (isCost)
                {
                    <label class="mt-2">Invoice cost amount</label>
                    <input name="costAmount" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                    <input type="hidden" name="costCategory" value="@type" />
                    <label class="check mt-2"><input type="checkbox" name="manualCostOverride" value="true" /> Manual / verified amount</label>
                    <small>OCR can be added later; for now this keeps profit accurate and editable.</small>
                }
                <button type="submit" class="btn btn-sm btn-secondary mt-2">Upload @type</button>
            </form>
        </div>
    </div>
}
</div>
